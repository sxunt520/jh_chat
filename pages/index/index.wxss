page {
  background-color: #000;
  height: 100%;
  overflow: hidden;
}

.container {
  position: relative;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* --- 顶部栏 --- */
.top-bar {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 50;
  padding: 20rpx 30rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
}

.diamond-btn {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10px);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 215, 0, 0.3);
  color: #ffd700;
  font-size: 24rpx;
}
.diamond-btn .icon { font-size: 32rpx; margin-right: 8rpx; }

/* --- Swiper --- */
.main-swiper {
  width: 100%;
  flex: 1;
  background: #000;
}
.page-content { position: relative; width: 100%; height: 100%; }
.page-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; }
.bg-mask {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0) 40%, rgba(0,0,0,0.8) 100%);
  z-index: 2; pointer-events: none;
}
.content-wrapper {
  position: relative; z-index: 10; width: 100%; height: 100%;
  display: flex; flex-direction: column; justify-content: space-between;
  padding-bottom: 20rpx; box-sizing: border-box;
}

/* 消息与按钮样式 (保持原有逻辑，略作微调) */
.message-area { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; padding: 40rpx 30rpx; padding-top: 100rpx; }
.message-area.history-mode { justify-content: flex-start; }
.latest-box {
  background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(10px);
  padding: 30rpx 50rpx; border-radius: 40rpx; text-align: center; color: #fff;
  font-size: 32rpx; align-self: center; max-width: 80%; border: 1rpx solid rgba(255,255,255,0.1);
  position: relative;
}
.hint-text { font-size: 20rpx; color: rgba(255,255,255,0.5); margin-top: 10rpx; display: block;}

.action-bar {
  display: flex; justify-content: space-around; align-items: center;
  padding: 20rpx 30rpx; background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px); border-radius: 50rpx; margin: 0 30rpx; border: 1rpx solid rgba(255,255,255,0.1);
}
.btn { display: flex; flex-direction: column; align-items: center; color: #fff; font-size: 22rpx; padding: 10rpx; }
.btn .icon { font-size: 38rpx; margin-bottom: 6rpx; }
.btn.active { color: #ffd700; }

/* --- 底部固定区域 (核心优化) --- */
.fixed-bottom-area {
  width: 100%;
  background: rgba(10, 10, 10, 0.98);
  border-top: 1rpx solid rgba(255,255,255,0.1);
  z-index: 100;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  /* 过渡动画，让菜单弹出更平滑 */
  transition: height 0.3s ease; 
}

/* 扩展菜单 */
.expand-menu {
  height: 0;
  overflow: hidden;
  display: flex;
  justify-content: space-around;
  padding: 0 40rpx;
  background: rgba(20, 20, 20, 0.95);
  transition: height 0.3s ease, padding 0.3s ease;
}
.expand-menu.show {
  height: 160rpx; /* 展开后的高度 */
  padding: 20rpx 40rpx;
}
.menu-item {
  display: flex; flex-direction: column; align-items: center;
  color: #fff; font-size: 24rpx;
}
.m-icon {
  width: 80rpx; height: 80rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; margin-bottom: 10rpx;
  background: #333;
}
.m-icon.bg-blue { background: linear-gradient(135deg, #4facfe, #00f2fe); }
.m-icon.bg-pink { background: linear-gradient(135deg, #ff9a9e, #fecfef); }

/* 输入条 */
.input-bar {
  display: flex;
  align-items: center;
  /* 【关键】原来可能是 20rpx，改为 10rpx 让内容更贴边 */
  padding: 10rpx 30rpx; 
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
  background: #1a1a1a;
}
.voice-btn { padding: 15rpx; margin-right: 15rpx; font-size: 36rpx; color: #fff; }
.text-input {
  flex: 1;
  /* 【关键】原来可能是 64rpx，改为 56rpx 或 50rpx */
  height: 56rpx; 
  line-height: 56rpx; /* 必须和 height 一致，保证文字垂直居中 */
  font-size: 30rpx;
  color: #fff;
  background: #333;
  border-radius: 28rpx; /* 半径也稍微减小，保持比例 */
  padding: 0 20rpx; /* 左右内边距也可以稍微减小 */
}
.voice-hint {
  flex: 1;
  height: 56rpx; /* 与 text-input 保持一致 */
  line-height: 56rpx;
  text-align: center;
  color: #888;
  font-size: 28rpx;
  background: #333;
  border-radius: 28rpx;
}
.send-btn { margin-left: 20rpx; color: #007aff; font-weight: bold; font-size: 28rpx; padding: 0 10rpx; }

/* --- 修改后的 + 号按钮样式 --- */
.plus-btn {
  /* 强制宽高与输入框一致 (输入框 height 是 64rpx) */
  width: 56rpx;
  height: 56rpx;
  
  /* 保持圆形 */
  border-radius: 50%; 
  
  /* 布局居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  
  /* 间距和背景 */
  margin-left: 15rpx;
  background: rgba(255, 255, 255, 0.1);
  
  /* 图标大小调整为适合 64rpx 容器 */
  font-size: 32rpx; 
  color: #fff;
  
  /* 防止点击态变形 */
  box-sizing: border-box;
  flex-shrink: 0; 
}

/* 可选：点击时的反馈效果 */
.plus-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

/* --- 评论弹窗 --- */
.modal-mask {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.6); z-index: 200;
  opacity: 0; pointer-events: none; transition: opacity 0.3s;
}
.modal-mask.show { opacity: 1; pointer-events: auto; }

.comment-modal {
  position: fixed; bottom: 0; left: 0; width: 100%;
  background: #1a1a1a; border-radius: 30rpx 30rpx 0 0;
  z-index: 201; padding-bottom: env(safe-area-inset-bottom);
  transform: translateY(100%); transition: transform 0.3s ease-out;
  display: flex; flex-direction: column;
  max-height: 70vh;
}
.comment-modal.show { transform: translateY(0); }

.modal-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 30rpx; border-bottom: 1rpx solid #333;
}
.modal-header .title { font-size: 32rpx; font-weight: bold; color: #fff; }
.modal-header .close { font-size: 40rpx; color: #888; padding: 10rpx; }

.modal-body {
  flex: 1; overflow-y: auto; padding: 30rpx;
  max-height: 50vh;
}
.comment-item { margin-bottom: 20rpx; font-size: 28rpx; color: #ddd; }
.comment-item .user { color: #007aff; font-weight: bold; margin-right: 10rpx; }
.empty-tip { text-align: center; color: #666; margin-top: 40rpx; }

.modal-footer {
  display: flex; padding: 20rpx 30rpx;
  background: #222; border-top: 1rpx solid #333;
}
.comment-input {
  flex: 1; background: #333; border-radius: 30rpx;
  padding: 15rpx 25rpx; font-size: 28rpx; color: #fff;
  margin-right: 15rpx;
}
.submit-btn {
  background: #007aff; color: #fff;
  padding: 0 30rpx; border-radius: 30rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
}

/* --- VIP 侧滑页 --- */
.vip-sidebar {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  z-index: 300; pointer-events: none;
}
.vip-sidebar.show { pointer-events: auto; }

.vip-mask {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.6); opacity: 0; transition: opacity 0.3s;
}
.vip-sidebar.show .vip-mask { opacity: 1; }

.vip-content {
  position: absolute; top: 0; left: 0; width: 80%; height: 100%;
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  transform: translateX(-100%); transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  padding: 60rpx 40rpx; padding-top: calc(60rpx + env(safe-area-inset-top));
  box-sizing: border-box; color: #fff;
  box-shadow: 10rpx 0 30rpx rgba(0,0,0,0.5);
}
.vip-sidebar.show .vip-content { transform: translateX(0); }

.vip-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 60rpx; }
.vip-title { font-size: 40rpx; font-weight: bold; color: #ffd700; }
.vip-close { font-size: 40rpx; color: #fff; }

.vip-card {
  background: rgba(255,255,255,0.1); border: 1rpx solid #ffd700;
  border-radius: 20rpx; padding: 40rpx; text-align: center;
  margin-bottom: 40rpx;
}
.vip-card .price { font-size: 48rpx; font-weight: bold; color: #ffd700; display: block; margin-bottom: 10rpx; }
.vip-card .desc { font-size: 26rpx; color: #ccc; display: block; margin-bottom: 30rpx; }
.buy-btn {
  background: #ffd700; color: #000; border: none;
  font-size: 32rpx; font-weight: bold; border-radius: 50rpx;
  padding: 10rpx 0; width: 80%;
}

.vip-features text {
  display: block; font-size: 28rpx; color: #eee;
  margin-bottom: 20rpx; padding-left: 20rpx;
  border-left: 4rpx solid #ffd700;
}

/* 聊天列表基础样式 (复用之前的) */
.history-list { width: 100%; height: 100%; }
.chat-item { margin-bottom: 30rpx; display: flex; flex-direction: column; }
.chat-item.self { align-items: flex-end; }
.chat-item.other { align-items: flex-start; }
.bubble { padding: 20rpx 30rpx; border-radius: 20rpx; font-size: 30rpx; max-width: 75%; }
.bubble-other { background: rgba(255,255,255,0.95); color: #333; border-bottom-left-radius: 4rpx; }
.bubble-self { background: #007aff; color: #fff; border-bottom-right-radius: 4rpx; }
.time { font-size: 20rpx; color: rgba(255,255,255,0.7); margin-top: 8rpx; padding: 0 10rpx; }