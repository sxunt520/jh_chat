/* 全局重置 */
page {
  height: 100%;
  background-color: #000;
  color: #fff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* 1. 背景 Swiper */
.background-swiper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.bg-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 2. 内容层 (浮在背景上) */
.content-layer {
  position: relative;
  z-index: 10;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-bottom: 140rpx; /* 为底部输入框留出空间 */
  pointer-events: none; /* 让点击穿透到背景，除非点到具体元素 */
}

.content-layer  {
  pointer-events: auto; /* 恢复子元素的点击事件 */
}

/* 消息区域 */
.message-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end; /* 默认靠下显示最新一条 */
  padding: 40rpx;
  margin-bottom: 20rpx;
}

/* 最新单条消息样式 */
.latest-message-wrapper {
  width: 100%;
  display: flex;
  justify-content: center;
}

.latest-message-box {
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10px);
  padding: 30rpx 50rpx;
  border-radius: 40rpx;
  max-width: 80%;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.5);
  border: 1rpx solid rgba(255,255,255,0.1);
}

.latest-text {
  font-size: 32rpx;
  line-height: 1.5;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.8);
}

/* 历史记录模式样式 */
.history-mode {
  justify-content: flex-start; /* 历史模式从头开始 */
  padding-top: 100rpx;
}

.history-list {
  width: 100%;
  height: 100%;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.chat-item {
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
}

.chat-item.self {
  align-items: flex-end;
}

.chat-item.other {
  align-items: flex-start;
}

.chat-bubble {
  padding: 20rpx 30rpx;
  border-radius: 20rpx;
  max-width: 70%;
  font-size: 30rpx;
  line-height: 1.4;
  position: relative;
}

.chat-bubble.other {
  background: rgba(255, 255, 255, 0.9);
  color: #333;
  border-bottom-left-radius: 4rpx;
}

.chat-bubble.self {
  background: #007aff;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.chat-time {
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 8rpx;
  padding: 0 10rpx;
}

/* 3. 互动按钮组 */
.action-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 20rpx 40rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
  backdrop-filter: blur(5px);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
  font-size: 24rpx;
  opacity: 0.9;
  transition: transform 0.2s;
}

.action-btn:active {
  transform: scale(0.9);
}

.action-btn .icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.5));
}

.action-btn.highlight.active {
  color: #ffd700;
}

.action-btn.highlight.active .icon {
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

/* 4. 底部输入框 */
.input-container {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background: rgba(20, 20, 20, 0.95);
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); /* 适配全面屏 */
  box-sizing: border-box;
  border-top: 1rpx solid rgba(255,255,255,0.1);
}

.input-box {
  display: flex;
  align-items: center;
  background: #333;
  border-radius: 40rpx;
  padding: 10rpx 20rpx;
}

.voice-btn, .send-btn {
  padding: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-btn .icon {
  font-size: 40rpx;
}

.send-btn {
  color: #007aff;
  font-size: 28rpx;
  font-weight: bold;
  padding-left: 20rpx;
}

.text-input {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 30rpx;
  color: #fff;
  padding: 0 20rpx;
  background: transparent;
}

.voice-hint {
  flex: 1;
  text-align: center;
  color: #999;
  font-size: 28rpx;
  height: 70rpx;
  line-height: 70rpx;
}

/* 动画类 */
.fade-in {
  animation: fadeIn 0.5s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}