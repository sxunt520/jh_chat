page { background: #000; height: 100%; overflow: hidden; }
.container { display: flex; flex-direction: column; height: 100vh; width: 100vw; }

/* --- 顶部 --- */
.top-bar { position: absolute; top: 0; left: 0; z-index: 50; padding: 40rpx 30rpx; }
.diamond-btn { display: flex; align-items: center; background: rgba(0,0,0,0.5); padding: 10rpx 20rpx; border-radius: 30rpx; color: #ffd700; border: 1rpx solid rgba(255,215,0,0.3); }
.diamond-btn .icon { font-size: 32rpx; margin-right: 8rpx; }

/* --- 主内容区 (Flex 自适应) --- */
.main-content { flex: 1; position: relative; overflow: hidden; }
.main-swiper { width: 100%; height: 100%; }
.page-item { position: relative; width: 100%; height: 100%; }

/* 全屏背景图 */
.full-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; }
.bg-mask { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0) 40%, rgba(0,0,0,0.8) 100%); z-index: 2; pointer-events: none; }

/* 内容层 */
.page-layer { position: relative; z-index: 10; width: 100%; height: 100%; box-sizing: border-box; padding-bottom: 20rpx; display: flex; flex-direction: column; justify-content: flex-end; }

/* 左侧角色信息 */
.role-info-box {
  position: absolute;
  bottom: 5rpx; /* 稍微调高一点，避开输入框 */
  left: 30rpx;
  /* 【关键】限制最大宽度为 50% */
  max-width: 50%; 
  display: flex;
  flex-direction: column;
  /* 文字超出省略 */
  overflow: hidden; 
}
.r-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.8);
  margin-bottom: 6rpx;
  /* 单行省略 */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.r-slogan {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.8);
  /* 多行省略 (最多2行) */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 右侧操作按钮 */
.action-box {
  position: absolute;
  bottom: 10rpx; /* 与左侧对齐 */
  right: 30rpx;
  /* 【关键】改为横向排列 */
  flex-direction: row; 
  gap: 20rpx; /* 图标间距调小，挨着近点 */
  align-items: center;
  padding: 10rpx 15rpx;
  border-radius: 30rpx;
  width: 40%;
  height: 50rpx;
}
.a-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.8);
  min-width: 40rpx; /* 防止挤压 */
  float: right;
  margin: 0 10rpx;
}
.a-btn .icon {
  font-size: 40rpx; /* 图标大小 */
  margin-bottom: 2rpx;
  line-height: 1;
}
.a-btn .num {
  font-size: 18rpx; /* 数字调小 */
  opacity: 0.9;
}
.a-btn.active { color: #ffd700; }

/* 消息区 */
.message-zone {
  width: 100%;
  padding: 0 30rpx;
  margin-bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 200rpx;
  /* 确保历史模式下高度足够 */
  box-sizing: border-box;
  position: absolute;
  bottom: 80rpx;
}
.message-zone.history-mode {
  justify-content: flex-start;
  /* 【关键】历史模式下占满剩余空间，但不要超过顶部 */
  height: 75vh; 
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}
.latest-bubble {
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(10px);
  padding: 20rpx 40rpx;
  border-radius: 30rpx;
  color: #fff;
  text-align: center;
  align-self: center;
  border: 1rpx solid rgba(255,255,255,0.1);
  max-width: 80%;
}
.latest-bubble .hint { display: block; font-size: 20rpx; color: rgba(255,255,255,0.5); margin-top: 5rpx; }

/* 聊天记录样式 */
.history-list {
  width: 100%;
  height: 100%;
  padding: 10rpx 0;
  box-sizing: border-box;
}

.chat-item {
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: row;
  width: 100%;
  box-sizing: border-box;
  align-items: flex-end;
}

/* 别人的消息：默认顺序 [头像][气泡]，靠左 */
.chat-item.other {
  justify-content: flex-start;
}
.chat-item.other .msg-avatar-box {
  order: 0; /* 头像在左 */
  margin-right: 15rpx;
  margin-left: 0;
}
.chat-item.other .bubble-container {
  order: 1; /* 气泡在右 */
  align-items: flex-start;
}

/* 自己的消息：调整顺序为 [气泡][头像]，靠右 */
.chat-item.self {
  justify-content: flex-end; /* 整体靠右 */
}
.chat-item.self .msg-avatar-box {
  order: 1; /* 头像排在后面 -> 视觉上在最右边 */
  margin-left: 15rpx; /* 气泡和头像之间的间距 */
  margin-right: 0;
}
.chat-item.self .bubble-container {
  order: 0; /* 气泡排前面 -> 视觉上在头像左边 */
  align-items: flex-end;
}

/* 头像区域 */
.msg-avatar-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 80rpx;
  flex-shrink: 0;
  /* 移除之前的 margin 干扰，由上面 specific 选择器控制 */
}
.msg-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.3);
  background: #333;
  margin-bottom: 8rpx;
}
.msg-name {
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 气泡容器 */
.bubble-container {
  display: flex;
  flex-direction: column;
  max-width: 70%; /* 限制气泡最大宽度 */
}
.container-other { align-items: flex-start; margin-left: 15rpx; }
.container-self { align-items: flex-end; margin-right: 15rpx; }

.bubble {
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.4;
  word-wrap: break-word;
  box-sizing: border-box;
}
.bubble-other { background: rgba(255,255,255,0.95); color: #333; border-top-left-radius: 4rpx; }
.bubble-self { background: #007aff; color: #fff; border-top-right-radius: 4rpx; }
.time {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 6rpx;
}
/* .chat-item.self .time { text-align: right; }
.chat-item.other .time { text-align: left; } */

/* --- 底部固定输入区 --- */
.fixed-input-area {
  /* 确保高度由内容决定或固定，不要有多余 padding */
  padding-bottom: env(safe-area-inset-bottom); 
  background: #111;
  border-top: 1rpx solid #333;
  position: relative; /* 为绝对定位的提示提供参照 */
}

/* 扩展菜单 */
.expand-menu { height: 0; overflow: hidden; display: flex; justify-content: space-around; background: #1a1a1a; transition: all 0.3s; }
.expand-menu.show { height: 80rpx; padding: 10rpx 0; }
.m-item { display: flex; flex-direction: column; align-items: center; color: #fff; font-size: 24rpx; }
.m-icon { width: 70rpx; height: 70rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; margin-bottom: 8rpx; }
.bg-b { background: linear-gradient(135deg, #4facfe, #00f2fe); }
.bg-p { background: linear-gradient(135deg, #ff9a9e, #fecfef); }

/* 输入行 */
.input-row {
  display: flex;
  align-items: center;
  /* 【关键】固定行高，去掉上下大 padding，只留左右 */
  height: 90rpx; /* 根据 baseInputHeight 调整，这里假设是 90 */
  padding: 0 20rpx; 
  box-sizing: border-box;
  background: #1a1a1a;
  width: 100%;
}

/* 头像 */
.u-avatar { width: 60rpx; height: 60rpx; border-radius: 50%; overflow: hidden; margin-right: 15rpx; border: 2rpx solid #333; flex-shrink: 0; }
.u-avatar image { width: 100%; height: 100%; }

/* 语音切换钮 */
.voice-toggle { padding: 10rpx; margin-right: 10rpx; color: #fff; font-size: 32rpx; }

/* 文本输入框 */
.txt-input { flex: 1; height: 60rpx; line-height: 60rpx; background: #333; border-radius: 30rpx; padding: 0 20rpx; color: #fff; font-size: 28rpx; margin-right: 10rpx; }

/* 【修复】语音输入框 */
.voice-box {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  background: #333;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  margin-right: 10rpx;
  transition: background 0.2s;
}
.voice-box.v-cancel { background: #ff4d4f !important; transform: scale(1.02); }
.voice-box.v-move { background: #555; }

/* 输入框内部元素高度统一 */
.u-avatar, .voice-toggle, .plus-btn, .send-btn {
  height: 60rpx; /* 统一高度 */
  display: flex;
  align-items: center;
  justify-content: center;
}
.txt-input, .voice-box {
  height: 60rpx;
  line-height: 60rpx;
  flex: 1;
  margin: 0 10rpx;
}

.v-text { color: #fff; font-size: 26rpx; z-index: 2; position: relative; }

/* 波纹动画 */
.wave-container { position: absolute; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; gap: 12rpx; opacity: 0; transition: opacity 0.2s; }
.wave-container.active { opacity: 1; }
.dot { width: 10rpx; height: 10rpx; background: rgba(255,255,255,0.6); border-radius: 50%; }
.d1 { animation: pulse 1s infinite 0s; }
.d2 { animation: pulse 1s infinite 0.2s; }
.d3 { animation: pulse 1s infinite 0.4s; }
@keyframes pulse { 0% {transform: scale(1);} 50% {transform: scale(1.6);} 100% {transform: scale(1);} }

/* 发送按钮 */
.send-btn { color: #007aff; font-weight: bold; font-size: 28rpx; padding: 0 15rpx; margin-right: 10rpx; }

/* +号按钮 */
.plus-btn { width: 60rpx; height: 60rpx; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 32rpx; flex-shrink: 0; }

/* 语音提示浮层 */
/* 【关键】语音提示浮层 - 移到上方外部 */
.voice-tip-float {
  position: absolute;
  /* 【关键】定位在输入框上方 (输入框高90 + 间距20 = 110rpx) */
  bottom: calc(90rpx + env(safe-area-inset-bottom) + 20rpx); 
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.85);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  color: #fff;
  font-size: 24rpx;
  white-space: nowrap;
  z-index: 105; /* 确保高于输入框 */
  pointer-events: none;
  display: flex;
  gap: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
  animation: popIn 0.2s ease-out;
}
.div { color: #666; }

@keyframes popIn {
  from { opacity: 0; transform: translate(-50%, 10rpx); }
  to { opacity: 1; transform: translate(-50%, 0); }
}

/* --- 通用弹窗 --- */
.modal-mask { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 200; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
.modal-mask.show { opacity: 1; pointer-events: auto; }

/* 评论弹窗 */
.comment-modal { position: fixed; bottom: 0; left: 0; width: 100%; background: #1a1a1a; border-radius: 30rpx 30rpx 0 0; z-index: 201; transform: translateY(100%); transition: transform 0.3s; display: flex; flex-direction: column; max-height: 60vh; }
.comment-modal.show { transform: translateY(0); }
.cm-header { padding: 30rpx; border-bottom: 1rpx solid #333; display: flex; justify-content: space-between; color: #fff; font-size: 32rpx; font-weight: bold; }
.cm-body { flex: 1; padding: 30rpx; overflow-y: auto; }
.c-item { margin-bottom: 20rpx; color: #ddd; font-size: 28rpx; }
.c-item .u { color: #007aff; font-weight: bold; margin-right: 10rpx; }
.cm-footer { padding: 20rpx; background: #222; display: flex; gap: 15rpx; }
.c-input { flex: 1; background: #333; border-radius: 25rpx; padding: 15rpx 20rpx; color: #fff; }
.c-btn { background: #007aff; color: #fff; padding: 0 30rpx; border-radius: 25rpx; display: flex; align-items: center; font-size: 28rpx; }

/* 角色详情弹窗 */
.role-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #121212;
  border-radius: 30rpx 30rpx 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  height: 80vh;
  display: flex;
  flex-direction: column;
  /* 确保能接收触摸事件 */
  touch-action: pan-y; 
}
.role-modal.show { transform: translateY(0); }
/* 提示：可以在顶部加个拖拽条视觉提示，可选 */
.rm-header {
  position: relative;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #333;
}
/* 顶部小横条，提示可拖动 */
.rm-header::before {
  content: '';
  position: absolute;
  top: 15rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 8rpx;
  background: #444;
  border-radius: 4rpx;
}
.rm-header .title { color: #fff; font-size: 32rpx; font-weight: bold; }
.close-x { color: #fff; font-size: 36rpx; padding: 10rpx; }
.ph { width: 56rpx; }
.rm-body { flex: 1; overflow-y: auto; padding-bottom: 40rpx; }
.rm-profile { padding: 40rpx 30rpx; text-align: center; }
.rp-img { width: 180rpx; height: 180rpx; border-radius: 50%; border: 4rpx solid #333; margin-bottom: 20rpx; }
.rp-name { font-size: 38rpx; font-weight: bold; color: #fff; display: block; margin-bottom: 10rpx; }
.rp-slogan { font-size: 26rpx; color: #ffd700; display: block; margin-bottom: 20rpx; font-style: italic; }
.rp-desc { font-size: 28rpx; color: #ccc; line-height: 1.6; display: block; text-align: left; }
.rm-gallery { padding: 0 30rpx; }
.sec-title { font-size: 30rpx; color: #fff; font-weight: bold; display: block; margin-bottom: 20rpx; }
.g-swiper { height: 350rpx; border-radius: 20rpx; }
.g-img { width: 100%; height: 100%; }

/* VIP 侧滑 */
.vip-sidebar { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 300; pointer-events: none; }
.vip-sidebar.show { pointer-events: auto; }
.vip-mask { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); opacity: 0; transition: opacity 0.3s; }
.vip-sidebar.show .vip-mask { opacity: 1; }
.vip-panel { position: absolute; top: 0; left: 0; width: 75%; height: 100%; background: linear-gradient(135deg, #1a1a2e, #16213e); transform: translateX(-100%); transition: transform 0.3s; padding: 60rpx 30rpx; color: #fff; }
.vip-sidebar.show .vip-panel { transform: translateX(0); }
.vp-h { display: flex; justify-content: space-between; font-size: 36rpx; font-weight: bold; margin-bottom: 50rpx; color: #ffd700; }
.vp-card { background: rgba(255,255,255,0.1); border: 1rpx solid #ffd700; padding: 40rpx; border-radius: 20rpx; text-align: center; }
.price { font-size: 40rpx; font-weight: bold; color: #ffd700; display: block; margin-bottom: 20rpx; }
.buy-btn { background: #ffd700; color: #000; border: none; font-size: 30rpx; font-weight: bold; border-radius: 40rpx; margin-top: 20rpx; }